{
	"name": "agent-telemetry",
	"version": "0.1.0",
	"description": "OpenTelemetry-based telemetry collector for AI coding agents (Claude Code, Codex, OpenCode)",
	"type": "module",
	"main": "src/index.ts",
	"bin": {
		"agent-telemetry": "src/cli.ts"
	},
	"scripts": {
		"dev": "bun run src/cli.ts",
		"build": "bun build src/cli.ts --compile --target bun --outfile agent-telemetry",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome format ."
	},
	"keywords": [
		"telemetry",
		"opentelemetry",
		"otlp",
		"ai-agent",
		"claude-code",
		"codex",
		"opencode",
		"observability",
		"llm"
	],
	"license": "MIT",
	"author": "",
	"repository": {
		"type": "git",
		"url": "https://github.com/nousresearch/agent-telemetry.git"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"@types/bun": "^1.3.14",
		"typescript": "^5.6.0"
	},
	"dependencies": {
		"yaml": "^2.9.0"
	}
}
